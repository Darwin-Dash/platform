{
  "name": "@dashevo/instantsend-chainlock-monitor",
  "version": "1.0.0",
  "description": "Standalone library for monitoring Dash InstantSend and ChainLock confirmations",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration --testTimeout=60000",
    "test:integration:manual": "node tests/integration/instantsend-chainlock-monitor.spec.js",
    "test:integration:auto": "node tests/integration/automated-instantsend-chainlock.spec.js"
  },
  "keywords": [
    "dash",
    "instantsend",
    "chainlock",
    "payment",
    "monitoring",
    "cryptocurrency"
  ],
  "author": "Dash Core Group",
  "license": "MIT",
  "dependencies": {
    "@dashevo/dapi-client": "^1.0.0",
    "@dashevo/dashcore-lib": "^0.20.0",
    "@dashevo/resilient-dapi-client": "file:../resilient-dapi-client"
  },
  "devDependencies": {
    "@dashevo/dash-rpc-client": "file:../dash-rpc-client",
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^2.0.0",
    "@vitest/ui": "^2.0.0",
    "dotenv": "^16.0.0",
    "typescript": "^5.3.0",
    "vitest": "^2.0.0"
  },
  "peerDependencies": {
    "@dashevo/dapi-client": "^1.0.0",
    "@dashevo/dashcore-lib": "^0.20.0"
  }
}

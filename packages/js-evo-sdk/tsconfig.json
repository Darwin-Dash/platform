{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "esnext",
    "moduleResolution": "node",
    "declaration": true,
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmitOnError": false,
    "outDir": "./dist",
    "rootDir": "./src",
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@dashevo/wasm-sdk/compressed": ["../wasm-sdk/dist/sdk.d.ts"],
      "@dashevo/wasm-sdk": ["../wasm-sdk/dist/sdk.d.ts"],
      "@dashevo/wasm-sdk/*": ["../wasm-sdk/dist/*"]
    }
  },
  "include": ["./src/**/*"],
  "exclude": ["node_modules", "**/__tests__/**/*", "**/tests/**/*"]
}

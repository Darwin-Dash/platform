{
  "name": "@dashevo/evo-sdk",
  "version": "3.0.0-rc.1",
  "type": "module",
  "main": "./dist/evo-sdk.module.js",
  "types": "./dist/sdk.d.ts",
  "exports": {
    ".": {
      "types": "./dist/sdk.d.ts",
      "import": "./dist/evo-sdk.module.js"
    },
    "./module": {
      "import": "./dist/evo-sdk.module.js"
    }
  },
  "sideEffects": false,
  "engines": {
    "node": ">=18.18"
  },
  "files": [
    "dist/**",
    "README.md"
  ],
  "dependencies": {
    "@dashevo/dapi-client": "workspace:*",
    "@dashevo/dashcore-lib": "~0.22.0",
    "@dashevo/transaction-finder": "workspace:*",
    "@dashevo/wallet-lib": "workspace:*",
    "@dashevo/wasm-sdk": "workspace:*",
    "bs58": "^4.0.1",
    "cbor": "^9.0.2",
    "crypto-js": "^4.2.0",
    "ink": "^6.6.0",
    "ink-select-input": "^6.2.0",
    "ink-text-input": "^6.0.0",
    "meow": "^14.0.0",
    "react": "^19.2.3"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "build:bundle": "rm -rf dist && tsc -p tsconfig.json && webpack --config webpack.config.cjs",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit/",
    "test:integration": "vitest run tests/integration/",
    "test:watch": "vitest",
    "test:e2e": "playwright test --config playwright.config.ts",
    "test:e2e:headed": "playwright test --config playwright.config.ts --headed",
    "test:all": "vitest run && playwright test --config playwright.config.ts",
    "test:coverage": "vitest run --coverage",
    "demo:cli": "node demo/cli/index.js",
    "demo:tui": "node demo/tui/index.js",
    "demo:web:dev": "cd demo/web && webpack serve --mode development",
    "demo:web:build": "cd demo/web && webpack --mode production",
    "demo:web:serve": "cd demo/web && npx http-server dist -p 8080 -s -c-1"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "@playwright/test": "^1.40.0",
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^20.0.0",
    "@types/react": "^19",
    "@typescript-eslint/eslint-plugin": "^5.55.0",
    "@typescript-eslint/parser": "^5.55.0",
    "@vitest/coverage-v8": "^1.0.0",
    "assert": "^2.0.0",
    "babel-loader": "^9.1.3",
    "browserify-zlib": "^0.2.0",
    "buffer": "^6.0.3",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "copy-webpack-plugin": "^11.0.0",
    "crypto-browserify": "^3.12.0",
    "css-loader": "^6.8.1",
    "dotenv": "^16.4.0",
    "eslint": "^8.53.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-airbnb-typescript": "^17.0.0",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-jsdoc": "^46.9.0",
    "events": "^3.3.0",
    "html-webpack-plugin": "^5.5.3",
    "https-browserify": "^1.0.0",
    "ora": "^8.0.0",
    "os-browserify": "^0.3.0",
    "path-browserify": "^1.0.1",
    "process": "^0.11.10",
    "stream-browserify": "^3.0.0",
    "stream-http": "^3.2.0",
    "string_decoder": "^1.3.0",
    "style-loader": "^3.3.3",
    "terser-webpack-plugin": "^5.3.11",
    "ts-loader": "^9.5.0",
    "typescript": "^5.3.0",
    "url": "^0.11.3",
    "util": "^0.12.4",
    "vitest": "^1.0.0",
    "vm-browserify": "^1.1.2",
    "webpack": "^5.94.0",
    "webpack-cli": "^4.9.1",
    "webpack-dev-server": "^4.15.1"
  }
}

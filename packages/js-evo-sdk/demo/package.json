{
  "name": "@dashevo/evo-sdk-identity-demo",
  "version": "1.0.0",
  "description": "Identity Management Website for Dash Platform",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "webpack serve --mode development",
    "build": "webpack --mode production",
    "dev": "webpack --mode development --watch",
    "serve:static": "npx http-server . -p 8080 -s -c-1",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run tests/unit/",
    "test:integration": "vitest run tests/integration/",
    "test:discovery": "vitest run tests/unit/identity-discovery.spec.js tests/integration/app-initialization-real-sdk.test.js",
    "test:sdk-loading": "vitest run tests/unit/app-sdk-loading.test.js",
    "test:automated": "node test-automated.js",
    "test:mcp": "node mcp-bridge.js",
    "test:e2e": "playwright test --config=playwright.config.cjs --project=chromium",
    "test:e2e:ui": "playwright test --config=playwright.config.cjs --ui",
    "test:e2e:headed": "playwright test --config=playwright.config.cjs --headed --project=chromium",
    "test:e2e:all-browsers": "playwright test --config=playwright.config.cjs",
    "test:e2e:discovery": "playwright test tests/e2e/identity-discovery.spec.js --config=playwright.config.cjs --project=chromium",
    "test:e2e:bundle": "playwright test tests/e2e/sdk-browser-bundle.spec.js --config=playwright.config.cjs --project=chromium",
    "test:e2e:focused": "npm run test:e2e:discovery && npm run test:e2e:bundle",
    "test:e2e:funding": "playwright test tests/e2e/wallet-funding*.spec.js --config=playwright.config.cjs --project=chromium",
    "test:e2e:funding:headed": "playwright test tests/e2e/wallet-funding*.spec.js --config=playwright.config.cjs --project=chromium --headed",
    "test:e2e:debug": "playwright test --config=playwright.config.cjs --debug",
    "test:e2e:runner": "yarn node run-browser-tests.cjs",
    "test:all": "npm run test && npm run test:e2e",
    "test:focused": "npm run test:sdk-loading && npm run test:discovery && npm run test:e2e:runner",
    "test:discovery-node": "yarn node ../test-wallet-discovery.js",
    "test:discovery-bundle": "webpack --config webpack.discovery-test.config.cjs --mode development",
    "test:discovery-bundle:prod": "webpack --config webpack.discovery-test.config.cjs --mode production",
    "test:wallet-lib": "npm run test:discovery-node && echo '' && echo '✅ Node.js test passed. Run: npm run test:discovery-bundle && open http://localhost:8080/test-discovery-bundle.html'",
    "test:testnet": "vitest run tests/testnet/",
    "test:testnet:utxo": "vitest run tests/testnet/testnet-utxo.spec.js",
    "test:testnet:realtime": "vitest run tests/testnet/testnet-realtime.spec.js",
    "test:testnet:auto": "vitest run tests/testnet/testnet-realtime-auto.spec.js"
  },
  "dependencies": {
    "@dashevo/evo-sdk": "workspace:*",
    "@dashevo/wallet-lib": "workspace:*",
    "@dashevo/transaction-finder": "workspace:*",
    "@dashevo/dapi-client": "workspace:*"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "@dashevo/dash-rpc-client": "workspace:*",
    "browserify-zlib": "^0.2.0",
    "dotenv": "^16.3.1",
    "https-browserify": "^1.0.0",
    "os-browserify": "^0.3.0",
    "stream-http": "^3.2.0",
    "vm-browserify": "^1.1.2",
    "@modelcontextprotocol/server-puppeteer": "^2025.5.12",
    "@playwright/test": "^1.49.0",
    "playwright": "^1.49.0",
    "@testing-library/dom": "^9.3.3",
    "@vitest/coverage-v8": "^1.0.4",
    "@vitest/ui": "^1.0.4",
    "babel-loader": "^9.1.3",
    "buffer": "^6.0.3",
    "copy-webpack-plugin": "^11.0.0",
    "crypto-browserify": "^3.12.0",
    "events": "^3.3.0",
    "css-loader": "^6.8.1",
    "happy-dom": "^12.10.3",
    "html-webpack-plugin": "^5.5.3",
    "playwright-core": "^1.56.1",
    "process": "^0.11.10",
    "puppeteer": "^24.24.0",
    "stream-browserify": "^3.0.0",
    "style-loader": "^3.3.3",
    "vitest": "^1.0.4",
    "webpack": "^5.94.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1"
  }
}

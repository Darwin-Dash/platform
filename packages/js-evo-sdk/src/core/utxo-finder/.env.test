# UTXO Finder Test Environment Configuration
# Copy this file to .env.local and customize for your environment

# ============================================================================
# RPC Configuration
# ============================================================================

# Local Testnet Node RPC (direct connection to localhost)
TESTNET_RPC_ENDPOINT=http://localhost:18332
TESTNET_RPC_USERNAME=dash
TESTNET_RPC_PASSWORD=dashpass

# Regtest RPC (through SSH tunnel to remote node)
REGTEST_RPC_ENDPOINT=http://localhost:20002
REGTEST_RPC_USERNAME=dash
REGTEST_RPC_PASSWORD=dashpass

# ============================================================================
# SSH Tunnel Configuration (for regtest)
# ============================================================================

# SSH connection to Dashmate server
DASHMATE_SSH_HOST=ruald@10.0.0.119

# Docker container name for seed node
SEED_CONTAINER=dashmate_36324776_local_seed-core-1

# SSH tunnel ports
RPC_PORT=20002
DAPI_PORT=2443

# ============================================================================
# Test Control Flags
# ============================================================================

# Skip specific test categories
SKIP_RPC_TESTS=false
SKIP_TESTNET_TESTS=false
SKIP_REGTEST_TESTS=false
SKIP_INTEGRATION_TESTS=false

# ============================================================================
# Network Configuration
# ============================================================================

# Custom testnet seeds (optional override, comma-separated)
# TESTNET_SEEDS=seed-1.testnet.networks.dash.org:1443,seed-2.testnet.networks.dash.org:1443

# DNS resolution settings
DNS_TIMEOUT=5000
DNS_RETRY_COUNT=3

# ============================================================================
# Test Data Configuration
# ============================================================================

# Block height to start scanning from (testnet)
START_HEIGHT=1346251

# Funded testnet address for testing
TESTNET_ADDRESS=yX3CJJ42ndx9Bn9vGZRD8cbwk8vth5aKyy

# Test mnemonic for address derivation
MNEMONIC=lamp truck drip furnace now swing income victory leisure popular jeans vehicle

# ============================================================================
# Timeout Configuration (milliseconds)
# ============================================================================

# RPC operation timeout
RPC_TIMEOUT=30000

# DAPI query timeout (longer for public testnet with high latency)
DAPI_TIMEOUT=180000

# Test hook timeout (beforeAll, afterAll, etc.)
HOOK_TIMEOUT=60000

# General test timeout
TEST_TIMEOUT=120000

# ============================================================================
# Retry Configuration
# ============================================================================

# Maximum retry attempts for network operations
MAX_RETRIES=5

# Exponential backoff configuration
RETRY_BASE_DELAY=1000
RETRY_MAX_DELAY=30000

# ============================================================================
# Circuit Breaker Configuration
# ============================================================================

# Number of failures before opening circuit
CIRCUIT_BREAKER_THRESHOLD=5

# Timeout before attempting recovery (milliseconds)
CIRCUIT_BREAKER_TIMEOUT=30000

# ============================================================================
# Logging Configuration
# ============================================================================

# Log level: debug, info, warn, error
LOG_LEVEL=info

# Verbose mode (equivalent to LOG_LEVEL=debug)
VERBOSE=false

# ============================================================================
# Notes
# ============================================================================
#
# Local Development:
# - Use local testnet node at localhost:18332
# - Use SSH tunnel to regtest server
# - Enable all test categories
#
# CI/CD:
# - Skip RPC tests (no local node)
# - Skip regtest tests (no SSH access)
# - Run unit tests and testnet integration only
#
# Troubleshooting:
# - Increase timeouts if tests fail on slow networks
# - Increase retries if tests are flaky
# - Enable VERBOSE=true for detailed logging
# - Use TestEnv.printConfig() to debug configuration

/**
 * Testnet Helpers for Integration Testing
 *
 * Architecture:
 * - DAPI Client: Connects to public Dash Platform testnet infrastructure (seeds + masternodes)
 *   Matches js-evo-sdk pattern using networkConfigs.testnet
 * - RPC Functions: Use local dash-cli for transaction/block operations
 *   Only needed for E2E tests with sendtoaddress/generateblocks
 *
 * Unlike regtest (which uses SSH tunnels to remote node + docker),
 * testnet DAPI uses public infrastructure with dynamic masternode discovery.
 * RPC still requires local node for write operations.
 */

import DAPIClient from '@dashevo/dapi-client';
import { DashRPCClient, createRPCClient } from './rpc-client';

/**
 * Testnet configuration
 * Matches js-dash-sdk defaults for consistency
 */
export const TESTNET_CONFIG = {
  // Public testnet configuration (matches js-evo-sdk pattern)
  dapi: {
    // Uses public infrastructure, no hardcoded address needed
    network: 'testnet',
    timeout: 10000, // Standard timeout for non-streaming requests (js-dash-sdk default)
    retries: 5,     // Standard retries for non-streaming requests (js-dash-sdk default)
  },

  // RPC configuration for local testnet node (optional, for E2E tests)
  rpc: {
    timeout: 10000,
  },
};

/**
 * Connect to public Dash Platform testnet via DAPIClient
 * Uses network name to auto-discover DAPI servers via seeds and masternodes
 * Matches js-evo-sdk pattern exactly
 *
 * @param timeout - Connection timeout in ms
 * @returns Connected DAPI client
 */
export async function connectToTestnet(
  timeout: number = TESTNET_CONFIG.dapi.timeout
): Promise<any> {
  try {
    // Initialize with network name - DAPIClient handles auto-discovery
    // Uses seeds from networkConfigs.testnet to discover masternodes
    // timeout: only applies to non-streaming requests (see js-dash-sdk pattern)
    // Streaming operations use timeout: undefined in their own options
    const client = new DAPIClient({
      network: 'testnet',
      timeout,
      retries: TESTNET_CONFIG.dapi.retries,
    });

    // Verify connection by getting blockchain status
    await client.core.getBlockchainStatus();

    return client;
  } catch (error) {
    throw new Error(
      `Failed to connect to testnet DAPI: ${
        error instanceof Error ? error.message : 'Unknown error'
      }`
    );
  }
}

/**
 * RPC client instance for testnet operations
 * Initialized on demand, reused across test calls
 */
let rpcClient: DashRPCClient | null = null;

/**
 * Initialize RPC client for testnet operations
 *
 * @param endpoint Optional RPC endpoint override
 * @param username Optional RPC username override
 * @param password Optional RPC password override
 * @returns Initialized RPC client
 */
export async function initRPC(
  endpoint?: string,
  username?: string,
  password?: string
): Promise<DashRPCClient> {
  const rpcEndpoint = endpoint || process.env.TESTNET_RPC_ENDPOINT || 'http://localhost:18332';
  const rpcUsername = username || process.env.TESTNET_RPC_USERNAME || 'dash';
  const rpcPassword = password || process.env.TESTNET_RPC_PASSWORD || 'dashpass';

  if (!rpcClient) {
    rpcClient = await createRPCClient({
      endpoint: rpcEndpoint,
      username: rpcUsername,
      password: rpcPassword,
      loggerIdentifier: 'Testnet-RPC',
    });
  }
  return rpcClient;
}

/**
 * Check if local testnet node is available via RPC
 * Used to determine if RPC tests (sendtoaddress, generateblocks) can run
 *
 * @returns true if RPC endpoint is available and responsive
 */
export async function isLocalTestnetNodeAvailable(): Promise<boolean> {
  try {
    const endpoint = process.env.TESTNET_RPC_ENDPOINT || 'http://localhost:18332';
    const username = process.env.TESTNET_RPC_USERNAME || 'dash';
    const password = process.env.TESTNET_RPC_PASSWORD || 'dashpass';

    const client = await createRPCClient({
      endpoint,
      username,
      password,
      loggerIdentifier: 'AvailabilityCheck',
      timeout: 5000,
    });
    await client.testConnection();
    return true;
  } catch {
    return false;
  }
}

/**
 * Get current testnet block height
 * @param client - DAPI client
 * @returns Current block height
 */
export async function getTestnetBlockHeight(client: any): Promise<number> {
  try {
    const status = await client.core.getBlockchainStatus();

    // Try multiple possible field names for block count
    const blockHeight =
      status?.blocks ||
      status?.chain?.blocksCount ||
      status?.chain?.headersCount ||
      status?.blocksCount ||
      0;

    if (blockHeight === 0) {
      throw new Error('Could not determine block height from status');
    }

    return blockHeight;
  } catch (error) {
    throw new Error(
      `Failed to get testnet block height: ${
        error instanceof Error ? error.message : 'Unknown error'
      }`
    );
  }
}

/**
 * Check if testnet is available
 * @param address - DAPI address to check
 * @returns true if reachable, false otherwise
 */
export async function isTestnetAvailable(
  address: string = TESTNET_CONFIG.dapi.address
): Promise<boolean> {
  try {
    const client = await connectToTestnet(address, 5000);
    await getTestnetBlockHeight(client);
    return true;
  } catch {
    return false;
  }
}

/**
 * Common test data setup for testnet
 * Connects to public Dash Platform testnet infrastructure
 */
export class TestnetSetup {
  private client: any | null = null;
  private blockHeight: number = 0;

  /**
   * Initialize testnet connection to public DAPI infrastructure
   * @returns this for chaining
   */
  async init(): Promise<this> {
    try {
      // Connect to public testnet via auto-discovery
      this.client = await connectToTestnet();
      this.blockHeight = await getTestnetBlockHeight(this.client);
      return this;
    } catch (error) {
      const msg = error instanceof Error ? error.message : String(error);
      throw new Error(
        `Testnet DAPI connection failed:\n${msg}\n\n` +
        `Unable to connect to public Dash Platform testnet. Check internet connectivity and verify seeds are accessible.`
      );
    }
  }

  /**
   * Get connected DAPI client
   */
  getClient(): any {
    if (!this.client) {
      throw new Error('Testnet not initialized - call init() first');
    }
    return this.client;
  }

  /**
   * Get current block height
   */
  getBlockHeight(): number {
    return this.blockHeight;
  }

  /**
   * Refresh block height
   */
  async refreshBlockHeight(): Promise<number> {
    if (!this.client) {
      throw new Error('Testnet not initialized');
    }
    this.blockHeight = await getTestnetBlockHeight(this.client);
    return this.blockHeight;
  }

  /**
   * Wait for new blocks on testnet
   */
  async waitForBlocks(blockCount: number = 1, timeout: number = 60000): Promise<number> {
    if (!this.client) {
      throw new Error('Testnet not initialized');
    }

    const startTime = Date.now();
    const startHeight = this.blockHeight;
    const targetHeight = startHeight + blockCount;

    while (Date.now() - startTime < timeout) {
      const currentHeight = await getTestnetBlockHeight(this.client);

      if (currentHeight >= targetHeight) {
        this.blockHeight = currentHeight;
        return currentHeight;
      }

      // Wait a bit before checking again
      await new Promise((resolve) => setTimeout(resolve, 500));
    }

    throw new Error(`Timeout waiting for ${blockCount} blocks on testnet`);
  }
}

/**
 * RPC Configuration for testnet (local node)
 */
export const TESTNET_RPC_CONFIG = {
  // Local dash-cli access (no SSH, no docker)
  timeout: 10000,
};

/**
 * Send funds to an address via local testnet
 * Uses JSON-RPC to communicate with local testnet node
 *
 * @param address - Dash testnet address to send to
 * @param amount - Amount in DASH
 * @returns Transaction ID
 */
export async function sendToAddressTestnet(
  address: string,
  amount: number
): Promise<string> {
  try {
    const client = await initRPC();
    return await client.sendToAddress(address, amount);
  } catch (error) {
    throw new Error(
      `Failed to send ${amount} DASH to ${address}: ${
        error instanceof Error ? error.message : 'Unknown error'
      }`
    );
  }
}

/**
 * Generate blocks on testnet (mine new blocks)
 * Uses JSON-RPC to communicate with local testnet node
 *
 * @param blockCount - Number of blocks to generate
 * @returns Array of generated block hashes
 */
export async function generateBlocksTestnet(blockCount: number = 1): Promise<string[]> {
  try {
    const client = await initRPC();
    return await client.generateBlocks(blockCount);
  } catch (error) {
    const errorMsg = error instanceof Error ? error.message : String(error);
    throw new Error(
      `Failed to generate ${blockCount} blocks on testnet: ${errorMsg}`
    );
  }
}

/**
 * Get transaction details from testnet RPC
 *
 * @param txid - Transaction ID
 * @returns Transaction details including confirmations, amount, address
 */
export async function getTransactionDetailsTestnet(txid: string): Promise<any> {
  try {
    const client = await initRPC();
    return await client.getTransaction(txid);
  } catch (error) {
    throw new Error(
      `Failed to get transaction details for ${txid}: ${
        error instanceof Error ? error.message : 'Unknown error'
      }`
    );
  }
}

/**
 * Get current block count from testnet RPC
 *
 * @returns Current block height
 */
export async function getBlockCountTestnet(): Promise<number> {
  try {
    const client = await initRPC();
    return await client.getBlockCount();
  } catch (error) {
    throw new Error(
      `Failed to get testnet block count: ${
        error instanceof Error ? error.message : 'Unknown error'
      }`
    );
  }
}

/**
 * Get a new address from the testnet wallet
 *
 * @returns New Dash testnet address
 */
export async function getNewAddressTestnet(): Promise<string> {
  try {
    const client = await initRPC();
    return await client.getNewAddress();
  } catch (error) {
    throw new Error(
      `Failed to get new testnet address: ${
        error instanceof Error ? error.message : 'Unknown error'
      }`
    );
  }
}

/**
 * Wait for a transaction to appear in the mempool or blockchain
 *
 * @param txid - Transaction ID to wait for
 * @param timeout - Maximum time to wait in ms
 * @returns Transaction details when found
 */
export async function waitForTransactionTestnet(
  txid: string,
  timeout: number = 60000
): Promise<any> {
  const startTime = Date.now();

  while (Date.now() - startTime < timeout) {
    try {
      const txDetails = await getTransactionDetailsTestnet(txid);
      return txDetails;
    } catch {
      // Transaction not found yet, wait and retry
      await new Promise((resolve) => setTimeout(resolve, 500));
    }
  }

  throw new Error(`Timeout waiting for transaction ${txid}`);
}

/**
 * Environment variable helpers for testnet
 */
export const TestnetEnv = {
  /**
   * Get START_HEIGHT from environment for UTXO scanning
   */
  getStartHeight(): number {
    return parseInt(process.env.START_HEIGHT || '1346251', 10);
  },

  /**
   * Get testnet address from environment
   */
  getTestnetAddress(): string {
    return process.env.TESTNET_ADDRESS || 'yX3CJJ42ndx9Bn9vGZRD8cbwk8vth5aKyy';
  },

  /**
   * Check if testnet tests are enabled
   */
  integrationsEnabled(): boolean {
    return process.env.SKIP_TESTNET_TESTS !== 'true';
  },
};

/**
 * Get the pre-funded testnet address from environment
 * This address is funded and has real UTXOs on testnet
 * Used by integration tests to find actual transactions
 *
 * @returns The funded testnet address
 */
export function getFundedTestnetAddress(): string {
  return TestnetEnv.getTestnetAddress();
}

/**
 * Validate that the mnemonic in .env derives to the expected testnet address
 * Ensures consistency between MNEMONIC and TESTNET_ADDRESS in .env
 * This verifies that address derivation at index 0 works correctly
 *
 * @returns Object with validation result and derived/expected addresses
 */
export async function validateMnemonicMatchesAddress(): Promise<{
  matches: boolean;
  derivedAddress: string;
  expectedAddress: string;
}> {
  // Dynamic async import to avoid circular dependencies in ESM context
  const { AddressDerivation } = await import('../../src/index');

  const mnemonic =
    process.env.MNEMONIC ||
    'lamp truck drip furnace now swing income victory leisure popular jeans vehicle';
  const expectedAddress = TestnetEnv.getTestnetAddress();

  // Derive address at index 0 (external, not change)
  const derived = AddressDerivation.deriveAddress(mnemonic, 'testnet', 0, 0, false);

  return {
    matches: derived.address === expectedAddress,
    derivedAddress: derived.address,
    expectedAddress: expectedAddress,
  };
}

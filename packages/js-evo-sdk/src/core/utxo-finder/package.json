{
  "name": "@dashevo/dash-utxo-finder",
  "version": "0.1.0",
  "description": "Lightweight stateless UTXO finder utility for Dash Platform",
  "license": "MIT",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:unit": "vitest run __tests__/unit/",
    "test:integration": "vitest run __tests__/integration/*regtest* __tests__/integration/*e2e-with-rpc*",
    "test:testnet": "vitest run __tests__/integration/*testnet*",
    "test:regtest": "vitest run __tests__/integration/regtest-utxo-discovery.test.ts",
    "test:manual": "node scripts/test-utxo-finder.js",
    "test:manual:regtest": "NETWORK=regtest node scripts/test-utxo-finder.js",
    "test:manual:testnet": "NETWORK=testnet LOG_LEVEL=debug node scripts/test-utxo-finder.js",
    "test:manual:mainnet": "NETWORK=mainnet LOG_LEVEL=debug node scripts/test-utxo-finder.js",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .js,.ts",
    "prepublishOnly": "npm run build",
    "tunnel:create": "node scripts/create-ssh-tunnels.js",
    "tunnel:cleanup": "pkill -f 'ssh.*-L.*2443' && pkill -f 'ssh.*-L.*20002' || true",
    "tunnel:status": "echo 'DAPI Tunnel:' && lsof -i :2443 | grep LISTEN || echo 'Not active'; echo 'RPC Tunnel:' && lsof -i :20002 | grep LISTEN || echo 'Not active'"
  },
  "dependencies": {
    "events": "^3.3.0"
  },
  "peerDependencies": {
    "@dashevo/dashcore-lib": "^0.20.46",
    "@dashevo/js-dapi-client": "^8.0.0",
    "@dashevo/resilient-dapi-client": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "@dashevo/dashcore-lib": {
      "optional": true
    },
    "@dashevo/js-dapi-client": {
      "optional": true
    },
    "@dashevo/resilient-dapi-client": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^1.0.0",
    "@vitest/ui": "^1.0.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dashevo/platform.git",
    "directory": "packages/dash-utxo-finder"
  }
}

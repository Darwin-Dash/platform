# UTXO Finder CI/CD Environment Configuration
# Used by GitHub Actions and other CI/CD systems

# ============================================================================
# RPC Configuration (NOT AVAILABLE IN CI)
# ============================================================================

# CI environments don't have local nodes, so RPC endpoints are not configured
# Tests requiring RPC will be skipped

# ============================================================================
# Test Control Flags
# ============================================================================

# Skip tests that require local infrastructure
SKIP_RPC_TESTS=true
SKIP_REGTEST_TESTS=true

# Testnet tests should work in CI (public infrastructure)
SKIP_TESTNET_TESTS=false
SKIP_INTEGRATION_TESTS=false

# ============================================================================
# Network Configuration
# ============================================================================

# Longer DNS timeout for CI networks
DNS_TIMEOUT=10000
DNS_RETRY_COUNT=5

# ============================================================================
# Test Data Configuration
# ============================================================================

# Use same testnet configuration as local
START_HEIGHT=1346251
TESTNET_ADDRESS=yX3CJJ42ndx9Bn9vGZRD8cbwk8vth5aKyy
MNEMONIC=lamp truck drip furnace now swing income victory leisure popular jeans vehicle

# ============================================================================
# Timeout Configuration (more generous for CI networks)
# ============================================================================

# Longer timeouts for potentially slower CI networks
RPC_TIMEOUT=60000
DAPI_TIMEOUT=240000
HOOK_TIMEOUT=90000
TEST_TIMEOUT=180000

# ============================================================================
# Retry Configuration (more aggressive for CI)
# ============================================================================

# More retries to handle CI network instability
MAX_RETRIES=7
RETRY_BASE_DELAY=1500
RETRY_MAX_DELAY=45000

# ============================================================================
# Circuit Breaker Configuration (more tolerant for CI)
# ============================================================================

# Higher threshold before opening circuit (CI can be flaky)
CIRCUIT_BREAKER_THRESHOLD=7
CIRCUIT_BREAKER_TIMEOUT=45000

# ============================================================================
# Logging Configuration
# ============================================================================

# More verbose logging in CI for debugging
LOG_LEVEL=info
VERBOSE=false

# ============================================================================
# CI Detection
# ============================================================================

# These are automatically set by CI systems:
# CI=true
# GITHUB_ACTIONS=true

# ============================================================================
# Notes for CI/CD
# ============================================================================
#
# What Works in CI:
# - Unit tests (no infrastructure needed)
# - Testnet integration tests (uses public seeds)
#
# What Doesn't Work in CI:
# - RPC tests (requires local Dash node)
# - Regtest tests (requires SSH to remote server)
#
# GitHub Actions Usage:
# - Set up environment variables in workflow file
# - Use longer timeouts to account for shared CI resources
# - Enable verbose logging for debugging failures
#
# Example workflow step:
#   - name: Run UTXO Finder Tests
#     env:
#       SKIP_RPC_TESTS: true
#       SKIP_REGTEST_TESTS: true
#       DAPI_TIMEOUT: 240000
#     run: npm test -- packages/dash-utxo-finder
